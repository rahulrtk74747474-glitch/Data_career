        },
        {
          "customer_id": "C003",
          "segment": "Affluent"
        }
      ],
      "expectedCommand": "LOOKUP customer_id C002 segment",
      "expectedRows": [
        {
          "customer_id": "C002",
          "segment": "SMB"
        }
      ],
      "hints": [
        "The lookup key is customer_id.",
        "The lookup value is C002.",
        "Return segment."
      ],
      "explanation": "Lookups map a stable key to a requested attribute without manually scanning the table.",
      "xp": 80
