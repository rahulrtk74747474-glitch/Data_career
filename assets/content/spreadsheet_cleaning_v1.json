    {
      "id": "sheet-formula-net-revenue-001",
      "title": "Net Revenue Formula",
      "skillKey": "spreadsheets",
      "difficulty": "Beginner",
      "companyKey": "ecommerce",
      "context": "Sales tracks gross revenue in B2 and discount rate in C2.",
      "prompt": "Write a touch-friendly workbook command for net revenue = gross × (1 - discount).",
      "datasetName": "sales_sheet",
      "rows": [
        {
          "row": 2,
          "gross_revenue": 1000,
          "discount_rate": 0.1
        }
      ],
      "expectedCommand": "FORMULA =B2*(1-C2)",
      "expectedRows": [],
      "hints": [
        "Start with the gross cell B2.",
        "Discount reduces gross revenue.",
        "Use one minus the discount rate before multiplying."
      ],
      "explanation": "Net revenue equals gross revenue multiplied by the retained percentage after discount.",
      "xp": 70
    },
    {
      "id": "sheet-formula-margin-001",
      "title": "Gross Margin Formula",
      "skillKey": "spreadsheets",
      "difficulty": "Beginner",
      "companyKey": "ecommerce",
      "context": "Finance stores revenue in B2 and cost in C2.",
      "prompt": "Write gross margin percentage as (revenue - cost) / revenue.",
      "datasetName": "margin_sheet",
      "rows": [
        {
          "row": 2,
          "revenue": 2000,
          "cost": 1400
        }
      ],
      "expectedCommand": "FORMULA =(B2-C2)/B2",
      "expectedRows": [],
      "hints": [
        "Margin starts with revenue minus cost.",
        "Divide profit by revenue.",
        "Keep the full expression in parentheses."
      ],
      "explanation": "Gross margin normalizes gross profit by revenue so businesses of different scale can be compared.",
      "xp": 75
    },
